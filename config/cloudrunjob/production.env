# ==============================================================================
# Configuración Cloud Run Job - Ambiente PRODUCTION
# Repositorio: njs-cr-job-ipam-backend (CCLA)
# ==============================================================================

# ==================================
# I. Configuración Base del Job
# ==================================
CLOUDRUNJOB_NAME=$CI_PROJECT_NAME
FUNCTION_SERVICE_ACCOUNT=sa-ipam-prd@ccla-prd.iam.gserviceaccount.com
CLOUDRUNJOB_REGION=southamerica-west1

# ==================================
# II. Ejecución (tasks, paralelismo, reintentos)
# ==================================
CLOUDRUNJOB_TASKS=1
CLOUDRUNJOB_PARALLELISM=1
CLOUDRUNJOB_MAX_RETRIES=3
CLOUDRUNJOB_TASK_TIMEOUT=900s
CLOUDRUNJOB_EXECUTE_NOW=false

# ==================================
# III. Infraestructura y Rendimiento
# ==================================
CLOUDRUNJOB_MEMORY=1Gi
CLOUDRUNJOB_CPU=1

CLOUDRUNJOB_ARGS=
CLOUDRUNJOB_COMMAND=

VPC_CONNECTOR=
VPC_SUBNET=projects/ccla-host-prd/regions/southamerica-west1/subnetworks/sub-prd-serverless
VPC_NETWORK=projects/ccla-host-prd/global/networks/vpc-ccla-prd

# Secret Manager (Proyecto production: 718423441094)
CLOUDRUNJOB_SECRETS=DATABASE_URL=projects/718423441094/secrets/iac-ipam-prd-db-url:latest,SESSION_SECRET=projects/718423441094/secrets/iac-ipam-prd-session-secret:latest

CLOUDRUNJOB_SQL_INSTANCE=ccla-prd:southamerica-west1:pg-ipam-prd

# ==================================
# IV. Variables de Aplicación IPAM
# ==================================
NODE_ENV=production
LOG_NIVEL=warn
MODULOS_DESACTIVADOS=jira,importacion,direcciones,respaldo,excel
RESERVA_TTL_HORAS=72
RESERVA_TTL_MAX_HORAS=168
LIMITE_ALMACEN=postgres
ALLOW_ANONYMOUS=false

IPAM_JOB_ACTION=drift

# ==================================
# V. Cloud Scheduler
# ==================================
CLOUD_SCHEDULER_JOB_NAME=sch-ipam-drift-prd
CLOUD_SCHEDULER_SERVICE_ACCOUNT=sa-scheduler-prd@ccla-prd.iam.gserviceaccount.com
CLOUD_SCHEDULER_LOCATION=southamerica-west1
