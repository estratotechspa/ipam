# ==============================================================================
# Arquetipo de Configuración Cloud Run Job por Ambiente
# Ruta esperada en cada repositorio consumidor:
#   config/cloudrunjob/<ambiente>.env   (ej: config/cloudrunjob/development.env)
# ==============================================================================
# Convención:
# - Variables sin comillas.
# - Para deshabilitar una variable opcional, dejarla vacía (ej: VPC_CONNECTOR=).
# - Este arquetipo NO tiene equivalente a CLOUDRUN_PORT/CLOUDRUN_INGRESS/
#   CLOUDRUN_CONCURRENCY/min-max-instances: un Job no atiende requests, esos
#   conceptos no aplican.
# ==============================================================================

# ==================================
# I. Configuración Base del Job
# ==================================
CLOUDRUNJOB_NAME=$CI_PROJECT_NAME
FUNCTION_SERVICE_ACCOUNT=
# Region de deploy (opcional; default southamerica-west1). Ej. us-west1:
# CLOUDRUNJOB_REGION=us-west1

# ==================================
# II. Ejecución (tasks, paralelismo, reintentos)
# ==================================
CLOUDRUNJOB_TASKS=1
CLOUDRUNJOB_PARALLELISM=1
CLOUDRUNJOB_MAX_RETRIES=3
CLOUDRUNJOB_TASK_TIMEOUT=600s

# Si true, ejecuta el Job inmediatamente despues de cada deploy (ademas de
# quedar disponible para Cloud Scheduler/manual). Util en development para
# probar sin esperar el cron. Default apagado.
CLOUDRUNJOB_EXECUTE_NOW=false

# ==================================
# III. Infraestructura y Rendimiento (Opcional)
# ==================================
CLOUDRUNJOB_MEMORY=512Mi
CLOUDRUNJOB_CPU=1

CLOUDRUNJOB_ARGS=
CLOUDRUNJOB_COMMAND=

# --- Red: DOS mecanismos, mutuamente excluyentes (igual que el Service) ---
# Opción 1 (legacy): VPC_CONNECTOR, dejar VPC_SUBNET/VPC_NETWORK vacías.
# Opción 2 (recomendada, Direct VPC egress): VPC_SUBNET (+ VPC_NETWORK en
#   Shared VPC), dejar VPC_CONNECTOR vacía.
VPC_CONNECTOR=
VPC_SUBNET=
VPC_NETWORK=

# --- Secretos (Secret Manager, integracion nativa de Cloud Run) ---
# Misma sintaxis que el Service: DESTINO=projects/<NUMERO>/secrets/<nombre>[:version]
#   development   secret-manager-develop          1008983607564
#   testing/qa    secret-manager-testing-460300   258023580078
#   production    secret-manager-prd-cla01        718423441094
# Politica CCLA: UN SECRETO POR VALOR. Nomenclatura:
# iac-<CI_PROJECT_ID>-[componente]-[tipo-secreto].
# Ejemplos:
# CLOUDRUNJOB_SECRETS=DATABASE_URL=projects/1008983607564/secrets/iac-$CI_PROJECT_ID-ipam-db-url:latest
# CLOUDRUNJOB_SECRETS=DATABASE_PASSWORD=projects/1008983607564/secrets/iac-$CI_PROJECT_ID-ipam-db-pass:latest
CLOUDRUNJOB_SECRETS=

DATABASE_PASSWORD_SECRET=

# Instancia Cloud SQL (si aplica): project:region:instance
CLOUDRUNJOB_SQL_INSTANCE=

# ==================================
# IV. Variables de Aplicación IPAM
# ==================================
# Base de datos: se puede usar DATABASE_URL o las variables individuales directas
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=ipam
DATABASE_USERNAME=ipam_app
DATABASE_PASSWORD=
DATABASE_SCHEMA=public

NODE_ENV=development
APP_LOG_LEVEL=INFO
MODULOS_DESACTIVADOS=jira,importacion,direcciones,respaldo,excel
RESERVA_TTL_HORAS=72
RESERVA_TTL_MAX_HORAS=168
LIMITE_ALMACEN=postgres
ALLOW_ANONYMOUS=false
CORS_ORIGEN=*
IPAM_JOB_ACTION=drift

# ==================================
# V. Cloud Scheduler (Opcional) — dispara la EJECUCION del Job
# ==================================
CLOUD_SCHEDULER_JOB_NAME=
CLOUD_SCHEDULER_SERVICE_ACCOUNT=
