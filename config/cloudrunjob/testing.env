# ==============================================================================
# Configuración Cloud Run Job - Ambiente TESTING / QA
# Repositorio: njs-cr-job-ipam-backend (CCLA)
# ==============================================================================

# ==================================
# I. Configuración Base del Job
# ==================================
CLOUDRUNJOB_NAME=$CI_PROJECT_NAME
FUNCTION_SERVICE_ACCOUNT=sa-ipam-qa@ccla-qa.iam.gserviceaccount.com
CLOUDRUNJOB_REGION=southamerica-west1

# ==================================
# II. Ejecución (tasks, paralelismo, reintentos)
# ==================================
CLOUDRUNJOB_TASKS=1
CLOUDRUNJOB_PARALLELISM=1
CLOUDRUNJOB_MAX_RETRIES=2
CLOUDRUNJOB_TASK_TIMEOUT=600s
CLOUDRUNJOB_EXECUTE_NOW=false

# ==================================
# III. Infraestructura y Rendimiento
# ==================================
CLOUDRUNJOB_MEMORY=512Mi
CLOUDRUNJOB_CPU=1

CLOUDRUNJOB_ARGS=
CLOUDRUNJOB_COMMAND=

VPC_CONNECTOR=
VPC_SUBNET=projects/ccla-host-qa/regions/southamerica-west1/subnetworks/sub-qa-serverless
VPC_NETWORK=projects/ccla-host-qa/global/networks/vpc-ccla-qa

# Secret Manager (Proyecto testing/qa: 258023580078)
CLOUDRUNJOB_SECRETS=DATABASE_URL=projects/258023580078/secrets/iac-ipam-qa-db-url:latest,SESSION_SECRET=projects/258023580078/secrets/iac-ipam-qa-session-secret:latest

CLOUDRUNJOB_SQL_INSTANCE=ccla-qa:southamerica-west1:pg-ipam-qa

# ==================================
# IV. Variables de Aplicación IPAM
# ==================================
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=ipam
DATABASE_USERNAME=ipam_app
DATABASE_PASSWORD=
DATABASE_SCHEMA=public

NODE_ENV=production
LOG_NIVEL=info
MODULOS_DESACTIVADOS=jira,importacion,direcciones,respaldo,excel
RESERVA_TTL_HORAS=72
RESERVA_TTL_MAX_HORAS=168
LIMITE_ALMACEN=postgres
ALLOW_ANONYMOUS=false
CORS_ORIGEN=*

IPAM_JOB_ACTION=drift

# ==================================
# V. Cloud Scheduler
# ==================================
CLOUD_SCHEDULER_JOB_NAME=sch-ipam-drift-qa
CLOUD_SCHEDULER_SERVICE_ACCOUNT=sa-scheduler-qa@ccla-qa.iam.gserviceaccount.com
CLOUD_SCHEDULER_LOCATION=southamerica-west1
