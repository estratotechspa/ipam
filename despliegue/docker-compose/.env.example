# Copia este archivo a .env (que NO se versiona). Todos los valores de aquí son de relleno.
DB_PASSWORD=cambia-esta-clave-local
PORT=8080
LOG_LEVEL=info

# Acceso. Para desarrollo local el modo abierto es práctico; para cualquier otra cosa, desactívalo:
ALLOW_ANONYMOUS=true
# Modo Basic (un solo usuario). Genera el hash con:  node mvp/scripts/hash-password.js 'tu-clave'
# APP_USER=admin
# APP_PASS=scrypt$16384$8$1$...
JIRA_WEBHOOK_SECRET=relleno-cambiar
