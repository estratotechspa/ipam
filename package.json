{
  "name": "njs-cr-job-ipam-backend",
  "version": "1.0.0",
  "description": "Backend IPAM adaptado al arquetipo Cloud Run de CCLA",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "build": "node scripts/build.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "migrar": "node src/cli/migrar.js",
    "purgar": "node src/cli/purgar.js",
    "drift": "node src/cli/detectar-drift.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "openid-client": "^6.8.8",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "read-excel-file": "^9.3.20",
    "swagger-ui-dist": "^5.33.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "fast-check": "^4.11.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "overrides": {
    "brace-expansion": "1.1.22",
    "uuid": "^11.1.1"
  }
}
